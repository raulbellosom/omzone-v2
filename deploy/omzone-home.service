[Unit]
Description=OMZONE Home SSR
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=omzone
Group=omzone
WorkingDirectory=/srv/omzone/current
ExecStart=/usr/bin/node server/index.mjs
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
Environment=PUBLIC_SITE_URL=https://omzone.com
# Production only. Keep true for any staging or development instance.
Environment=HOME_NOINDEX=false
Environment=HOME_TIMEOUT_MS=3000
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
